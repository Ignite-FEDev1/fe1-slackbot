# ⚠️ 모든 키가 채워져 있어야 배포(sls deploy)가 성공합니다.
#    실제 값은 성주님께 .env 파일 통째로 받으세요.

# Slack 앱
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-

# FEHG Jira (ignitecorp.atlassian.net)
ATLASSIAN_TOKEN=

# LLM
GROQ_API_KEY=gsk_
ANTHROPIC_API_KEY=sk-ant-

# 리포트 메일 발송
RESEND_API_KEY=re_

# GitLab (monthly-report 데이터 수집)
GITLAB_BASE_URL=
GITLAB_TOKEN=

# Supabase (사용자별 Jira 인증정보, settings)
NEXT_PUBLIC_DB_URL=
DB_SERVICE_ROLE_KEY=

# fe1-web 연동
VERCEL_BYPASS_SECRET=

# Chrome Extension API
EXTENSION_API_KEY=
EXT_NOTIFY_SLACK_CHANNEL=
